noncomputable def exactUpper (lo hi : Fin 64 → ℤ) (j : Fin 10) : ℝ :=
  bias j + ∑ i, max (weight j i * inputValue lo i) (weight j i * inputValue hi i)

lemma mul_interval {w l x u : ℝ} (hx : l ≤ x ∧ x ≤ u) :
    min (w*l) (w*u) ≤ w*x ∧ w*x ≤ max (w*l) (w*u) := by
  by_cases hw : 0 ≤ w
  · have hwl : w*l ≤ w*x := mul_le_mul_of_nonneg_left hx.1 hw
    have hwu : w*x ≤ w*u := mul_le_mul_of_nonneg_left hx.2 hw
    rw [min_eq_left (le_trans hwl hwu), max_eq_right (le_trans hwl hwu)]
    exact ⟨hwl, hwu⟩
  · have hw' : w ≤ 0 := le_of_not_ge hw
    have hwu : w*u ≤ w*x := mul_le_mul_of_nonpos_left hx.2 hw'
    have hwl : w*x ≤ w*l := mul_le_mul_of_nonpos_left hx.1 hw'
    rw [min_eq_right (le_trans hwu hwl), max_eq_left (le_trans hwu hwl)]
    exact ⟨hwu, hwl⟩

lemma linear_enclosure (lo hi : Fin 64 → ℤ) (x : Fin 64 → ℝ)
    (hx : ∀ i, inputValue lo i ≤ x i ∧ x i ≤ inputValue hi i) (j : Fin 10) :
    exactLower lo hi j ≤ eval x j ∧ eval x j ≤ exactUpper lo hi j := by
  constructor <;> simp only [exactLower, exactUpper, eval, add_le_add_iff_left] <;>
    apply Finset.sum_le_sum <;> intro i _
  · exact (mul_interval (hx i)).1
  · exact (mul_interval (hx i)).2

def lowerNum (lo hi : Fin 64 → ℤ) (j : Fin 10) : ℤ :=
  biasZ j * sourceScale + ∑ i, min (weightsZ j i * lo i) (weightsZ j i * hi i)
def upperNum (lo hi : Fin 64 → ℤ) (j : Fin 10) : ℤ :=
  biasZ j * sourceScale + ∑ i, max (weightsZ j i * lo i) (weightsZ j i * hi i)

private theorem numeric0 (j : Fin 10) :
    certLo0Z j * (sourceScale*sourceScale) ≤ lowerNum inputLo0Z inputHi0Z j * certificateScale ∧
      upperNum inputLo0Z inputHi0Z j * certificateScale ≤ certHi0Z j * (sourceScale*sourceScale) := by
  decide +revert

private theorem numeric7 (j : Fin 10) :
    certLo7Z j * (sourceScale*sourceScale) ≤ lowerNum inputLo7Z inputHi7Z j * certificateScale ∧
      upperNum inputLo7Z inputHi7Z j * certificateScale ≤ certHi7Z j * (sourceScale*sourceScale) := by
  decide +revert

lemma lower_bridge (lo hi : Fin 64 → ℤ) (j : Fin 10) :
    exactLower lo hi j = (lowerNum lo hi j : ℝ) / (((sourceScale*sourceScale : ℤ) : ℝ)) := by
  simp only [exactLower, lowerNum, weight, bias, inputValue, div_eq_mul_inv, Int.cast_add,
    Int.cast_mul, Int.cast_sum, Int.cast_min]
  ring_nf
  rw [Finset.mul_sum]
  congr 1
  · norm_num [sourceScale]; ring
  · apply Finset.sum_congr rfl
    intro i _
    rw [mul_min_of_nonneg _ _ (sq_nonneg (((sourceScale : ℤ) : ℝ)⁻¹))]
    congr 1 <;> ring

lemma upper_bridge (lo hi : Fin 64 → ℤ) (j : Fin 10) :
    exactUpper lo hi j = (upperNum lo hi j : ℝ) / (((sourceScale*sourceScale : ℤ) : ℝ)) := by
  simp only [exactUpper, upperNum, weight, bias, inputValue, div_eq_mul_inv, Int.cast_add,
    Int.cast_mul, Int.cast_sum, Int.cast_max]
  ring_nf
  rw [Finset.mul_sum]
  congr 1
  · norm_num [sourceScale]; ring
  · apply Finset.sum_congr rfl
    intro i _
    rw [mul_max_of_nonneg _ _ (sq_nonneg (((sourceScale : ℤ) : ℝ)⁻¹))]
    congr 1 <;> ring

private lemma scaled_lower {cert : Fin 10 → ℤ} {lo hi : Fin 64 → ℤ} (j : Fin 10)
    (hZ : cert j * (sourceScale*sourceScale) ≤ lowerNum lo hi j * certificateScale) :
    certValue cert j ≤ exactLower lo hi j := by
  rw [lower_bridge]
  have h : (cert j : ℝ) * (((sourceScale*sourceScale : ℤ) : ℝ)) ≤
      (lowerNum lo hi j : ℝ) * (certificateScale : ℝ) := by exact_mod_cast hZ
  apply (div_le_div_iff₀ (by norm_num [certificateScale]) (by norm_num [sourceScale])).2
  simpa [certValue, mul_comm] using h

private lemma scaled_upper {cert : Fin 10 → ℤ} {lo hi : Fin 64 → ℤ} (j : Fin 10)
    (hZ : upperNum lo hi j * certificateScale ≤ cert j * (sourceScale*sourceScale)) :
    exactUpper lo hi j ≤ certValue cert j := by
  rw [upper_bridge]
  have h : (upperNum lo hi j : ℝ) * (certificateScale : ℝ) ≤
      (cert j : ℝ) * (((sourceScale*sourceScale : ℤ) : ℝ)) := by exact_mod_cast hZ
  apply (div_le_div_iff₀ (by norm_num [sourceScale]) (by norm_num [certificateScale])).2
  simpa [certValue, mul_comm] using h

/--
Hash-bound, outward-rounded exact-real enclosure of the pinned TorchLean digits linear classifier
for source examples 0 and 7. Every displayed decimal endpoint encloses the exact linear score.

@prooflens.torchlean-enclosure v0.1
-/
theorem digits_examples_enclosed (sample : Fin 2) (x : Fin 64 → ℝ)
    (hx : ∀ i, inputValue (if sample = 0 then inputLo0Z else inputLo7Z) i ≤ x i ∧
      x i ≤ inputValue (if sample = 0 then inputHi0Z else inputHi7Z) i) :
    ∀ j, certValue (if sample = 0 then certLo0Z else certLo7Z) j ≤ eval x j ∧
      eval x j ≤ certValue (if sample = 0 then certHi0Z else certHi7Z) j := by
  intro j
  fin_cases sample
  · simp only [Fin.zero_eta, ↓reduceIte] at hx ⊢
    exact ⟨le_trans (scaled_lower j (numeric0 j).1) (linear_enclosure inputLo0Z inputHi0Z x hx j).1,
      le_trans (linear_enclosure inputLo0Z inputHi0Z x hx j).2 (scaled_upper j (numeric0 j).2)⟩
  · simp only [OfNat.ofNat] at hx ⊢
    exact ⟨le_trans (scaled_lower j (numeric7 j).1) (linear_enclosure inputLo7Z inputHi7Z x hx j).1,
      le_trans (linear_enclosure inputLo7Z inputHi7Z x hx j).2 (scaled_upper j (numeric7 j).2)⟩

end ProofLens.Examples.TorchLeanDigits

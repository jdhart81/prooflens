    certLoZ 0 j * (sourceScale*sourceScale) ≤ lowerNum (inputsLoZ 0) (inputsHiZ 0) j * certificateScale ∧
      upperNum (inputsLoZ 0) (inputsHiZ 0) j * certificateScale ≤ certHiZ 0 j * (sourceScale*sourceScale) := by
